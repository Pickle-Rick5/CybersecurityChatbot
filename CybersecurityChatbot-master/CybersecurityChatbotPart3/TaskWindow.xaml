<Window x:Class="CybersecurityChatbotPart3.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assistant"
        Height="700" Width="560"
        Background="#0C0C0C"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B3B36"/>
            <Setter Property="Foreground" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00CC7A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="[ TASK ASSISTANT ]" FontFamily="Consolas" FontSize="18"
                   FontWeight="Bold" Foreground="#00FF9C" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Add task form -->
        <Border Grid.Row="1" BorderBrush="#00FF9C" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Task title" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                <TextBox x:Name="TitleTextBox" MaxLength="100"/>

                <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="DescriptionTextBox" MaxLength="500" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="Reminder (optional)" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="ReminderCombo" SelectedIndex="0"
                          SelectionChanged="ReminderCombo_SelectionChanged">
                    <ComboBoxItem Content="No reminder"/>
                    <ComboBoxItem Content="In 1 day"/>
                    <ComboBoxItem Content="In 3 days"/>
                    <ComboBoxItem Content="In 7 days"/>
                    <ComboBoxItem Content="Pick a date..."/>
                </ComboBox>
                <DatePicker x:Name="CustomDatePicker" Visibility="Collapsed" Margin="0,6,0,0"/>

                <Button x:Name="AddButton" Content="Add Task" Click="AddButton_Click"
                        Margin="0,10,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Task list -->
        <Border Grid.Row="2" BorderBrush="#333333" BorderThickness="1" Background="#0F0F0F">
            <ListBox x:Name="TasksListBox" Background="#0F0F0F" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontFamily="Consolas"
                                       FontSize="14" FontWeight="Bold" Foreground="#00FF9C"/>
                            <TextBlock Text="{Binding Description}" FontFamily="Consolas"
                                       Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FFD966">
                                <Run Text="{Binding ReminderText, Mode=OneWay}"/>
                                <Run Text="   |   "/>
                                <Run Text="{Binding StatusText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="#777777"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Mark Completed" Click="CompleteButton_Click" Margin="0,0,8,0"/>
            <Button Content="Delete Task" Click="DeleteButton_Click" Margin="0,0,8,0"/>
            <Button Content="Close" Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Foreground="#FF6B6B" FontFamily="Consolas"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>