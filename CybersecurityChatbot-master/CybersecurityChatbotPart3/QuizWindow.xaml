<Window x:Class="CybersecurityChatbotPart3.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz"
        Height="640" Width="580"
        Background="#0C0C0C"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B3B36"/>
            <Setter Property="Foreground" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="[ CYBER QUIZ ]" FontFamily="Consolas" FontSize="18"
                   FontWeight="Bold" Foreground="#00FF9C" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock x:Name="ProgressTextBlock" Grid.Row="1" FontFamily="Consolas" FontSize="13"
                   Foreground="#FFD966" Margin="0,0,0,10"/>

        <Border Grid.Row="2" BorderBrush="#00FF9C" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="QuestionTextBlock" FontFamily="Consolas" FontSize="15"
                       Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <StackPanel x:Name="OptionsPanel" Grid.Row="3" Margin="4,0,0,10"/>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="FeedbackTextBlock" FontFamily="Consolas" FontSize="14"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="SubmitButton" Content="Submit Answer" Click="SubmitButton_Click" Margin="0,0,8,0"/>
            <Button x:Name="NextButton" Content="Next Question" Click="NextButton_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>