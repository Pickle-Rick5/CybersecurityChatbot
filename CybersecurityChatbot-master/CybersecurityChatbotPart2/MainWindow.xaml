<Window x:Class="CybersecurityChatbotPart2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="600" Width="500"
        Background="#0C0C0C"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B3B36"/>
            <Setter Property="Foreground" Value="#00FF9C"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#00FF9C"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: ASCII-style banner -->
        <Border Grid.Row="0" BorderBrush="#00FF9C" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="[ SECURE SHIELD ]"
                           FontFamily="Consolas" FontSize="18" FontWeight="Bold"
                           Foreground="#00FF9C" HorizontalAlignment="Center"/>
                <TextBlock Text="CYBERSECURITY AWARENESS BOT"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="#00CC7A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat log -->
        <Border Grid.Row="1" BorderBrush="#333333" BorderThickness="1" Background="#0F0F0F">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8">
                <StackPanel x:Name="ChatLogPanel"/>
            </ScrollViewer>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputTextBox" Grid.Column="0" Margin="0,0,8,0"
                     KeyDown="InputTextBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>